{
    "name": "smn/laravel-template-structure",
    "description": "Installer-style Laravel package that scaffolds a clean, scalable, OOAD-based, OWASP-hardened, versioned-API architecture into any Laravel 10/11/12 application.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "scaffold",
        "installer",
        "architecture",
        "ooad",
        "owasp",
        "api-versioning",
        "repository-pattern"
    ],
    "authors": [
        {
            "name": "Somonor Hong",
            "email": "somonorhong011@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Smn\\LaravelTemplateStructure\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Smn\\LaravelTemplateStructure\\LaravelTemplateStructureServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
